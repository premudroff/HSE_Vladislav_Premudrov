class CourtCase:
    """Судебное дело: номер, участники, заседания, решение."""
    
    # Атрибут класса — общий для всех дел
    court_system = "Арбитражные суды РФ"
    total_cases = 0
    
    def __init__(self, case_number, participants=None, listening_datetimes=None):
        """
        Конструктор экземпляра.
        
        Аргументы:
            case_number (str): Номер дела (обязательный)
            participants (list, optional): Список участников. По умолчанию None.
            listening_datetimes (list, optional): Список дат заседаний. По умолчанию None.
        """
        # Увеличиваем общий счётчик дел
        CourtCase.total_cases += 1
        
        # Обязательный атрибут
        self.case_number = case_number
        
        # Списки создаём через None, чтобы избежать общей ссылки
        self.case_participants = participants if participants is not None else []
        self.listening_datetimes = listening_datetimes if listening_datetimes is not None else []
        
        # Атрибуты с значениями по умолчанию
        self.is_finished = False
        self.verdict = ""
    
    # ─── Методы для работы с заседаниями ───
    
    def set_a_listening_datetime(self, datetime_str):
        """
        Добавляет дату и время судебного заседания.
        
        Аргументы:
            datetime_str (str): Дата и время заседания в формате "ГГГГ-ММ-ДД ЧЧ:ММ"
        
        Возвращает:
            bool: True, если заседание добавлено, иначе False
        """
        # Проверка, что дело не завершено
        if self.is_finished:
            print(f"Дело {self.case_number} уже завершено. Нельзя добавить заседание.")
            return False
        
        # Простая валидация формата даты
        # Можно расширить до полноценной проверки с datetime
        if not datetime_str or not isinstance(datetime_str, str):
            print(f"Некорректная дата: {datetime_str}")
            return False
        
        # Проверяем, не дублируется ли заседание
        if datetime_str in self.listening_datetimes:
            print(f"Заседание на {datetime_str} уже запланировано")
            return False
        
        # Добавляем заседание
        self.listening_datetimes.append(datetime_str)
        print(f"Дело {self.case_number}: заседание добавлено на {datetime_str}")
        return True
    
    # ─── Методы для работы с участниками ───
    
    def add_participant(self, inn):
        """
        Добавляет участника дела по ИНН.
        
        Аргументы:
            inn (str): ИНН участника (10 или 12 цифр)
        
        Возвращает:
            bool: True, если участник добавлен, иначе False
        """
        # Проверка, что дело не завершено
        if self.is_finished:
            print(f"Дело {self.case_number} уже завершено. Нельзя добавить участника.")
            return False
        
        # Валидация ИНН (как в классе Contract из первой части)
        if not inn.isdigit():
            print(f"ИНН должен состоять из цифр: {inn}")
            return False
        
        if len(inn) not in (10, 12):
            print(f"ИНН — 10 или 12 цифр, получено {len(inn)}")
            return False
        
        # Проверка на дубликат
        if inn in self.case_participants:
            print(f"Участник {inn} уже добавлен в дело {self.case_number}")
            return False
        
        # Добавляем участника
        self.case_participants.append(inn)
        print(f"Дело {self.case_number}: участник {inn} добавлен")
        return True
    
    def remove_participant(self, inn):
        """
        Удаляет участника из дела по ИНН.
        
        Аргументы:
            inn (str): ИНН участника для удаления
        
        Возвращает:
            bool: True, если участник удалён, иначе False
        """
        # Проверка, что дело не завершено
        if self.is_finished:
            print(f"Дело {self.case_number} уже завершено. Нельзя удалить участника.")
            return False
        
        # Поиск и удаление участника
        if inn in self.case_participants:
            self.case_participants.remove(inn)
            print(f"Дело {self.case_number}: участник {inn} удалён")
            return True
        else:
            print(f"Участник {inn} не найден в деле {self.case_number}")
            return False
    
    # ─── Методы для вынесения решения ───
    
    def make_a_decision(self, verdict_text):
        """
        Выносит решение по делу.
        
        Аргументы:
            verdict_text (str): Текст решения суда
        
        Возвращает:
            bool: True, если решение вынесено, иначе False
        """
        # Проверка, что дело ещё не завершено
        if self.is_finished:
            print(f"Дело {self.case_number} уже завершено. Решение: {self.verdict}")
            return False
        
        # Проверка, что решение не пустое
        if not verdict_text or not isinstance(verdict_text, str):
            print(f"Некорректный текст решения: {verdict_text}")
            return False
        
        # Выносим решение
        self.verdict = verdict_text
        self.is_finished = True
        print(f"Дело {self.case_number}: решение вынесено — \"{verdict_text}\"")
        return True
    
    # ─── Магические методы ───
    
    def __str__(self):
        """
        Человекочитаемое представление дела.
        Используется в print(), str(), f-строках.
        """
        status = "Завершено" if self.is_finished else "В работе"
        participants_count = len(self.case_participants)
        hearings_count = len(self.listening_datetimes)
        
        return (f"Дело {self.case_number} | Статус: {status} | "
                f"Участников: {participants_count} | Заседаний: {hearings_count}")
    
    def __repr__(self):
        """
        Техническое представление для разработчиков.
        Используется в интерактивной среде и при отладке.
        """
        return (f"CourtCase(case_number='{self.case_number}', "
                f"participants={self.case_participants}, "
                f"hearings={self.listening_datetimes})")
    
    def __eq__(self, other):
        """
        Сравнение дел по смыслу.
        Два дела считаются равными, если совпадают номера.
        """
        if not isinstance(other, CourtCase):
            return False
        return self.case_number == other.case_number
