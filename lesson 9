# Задание 2. Генерация массива через range
dicts = [
    {
        "num_1": random.randint(1, 1_000_000),
        "num_2": random.randint(1, 1_000_000),
    }
    for _ in range(N)
]

print(f"Сгенерирован массив dicts: {len(dicts):,} элементов")
