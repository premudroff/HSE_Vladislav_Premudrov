# Задание 3. Сортировка пузырьком
def bubble_sort(arr):
    """Сортировка пузырьком (по возрастанию). Меняет список на месте."""
    n = len(arr)
    for i in range(n):
        swapped = False
        for j in range(0, n - i - 1):
            if arr[j] > arr[j + 1]:
                arr[j], arr[j + 1] = arr[j + 1], arr[j]
                swapped = True
        if not swapped:
            break
    return arr


# Сортировка первого массива
start = time.perf_counter()
bubble_sort(numbers)
elapsed_bubble = time.perf_counter() - start

print(f"Пузырёк на {N:,} элементах: {elapsed_bubble:.2f} сек")
print(f"Первые 10 после сортировки: {numbers[:10]}")

